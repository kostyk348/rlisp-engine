;; sample_global.lisp — пример глобальной модификации поверх рулсета.
;; Мод меняет мир, а не добавляет контент «рядом»: усиливает пистолет,
;; добавляет пришельца-ветерана и вводит новое правило-подсчёт.

;; 1) пистолет становится сильнее: урон 4..7 вместо 2..5
(register! 'weapon (mkrule "pistol"
  '(name "Пистолет (мод: усиленный)" tu 20 damage-min 4 damage-max 7 range 12 accuracy 10)))

;; 2) новый пришелец: ветеран-сектоид, сильнее обычного
(register! 'alien (mkrule "sectoid-veteran"
  '(name "Сектоид-ветеран" hp 9 tu 70 psi-skill 40 armor 1)))

;; 3) новое правило: штраф пришельцев за дальность сильнее, чем у бойцов
;;    (мод меняет механику, а не только числа)
(define (alien-accuracy distance)
  (let ((chance (- 60 (* 9 distance))))
    (if (< chance 5) 5 (if (> chance 85) 85 chance))))

(print "sample_global: пистолет усилен, сектоид-ветеран в игре, штраф пришельцев переписан")
